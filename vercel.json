{
  "version": 2,
  "builds": [
    {
      "src": "pages/api/telegram.py",
      "use": "@vercel/python"
    },
    {
      "src": "pages/api/signal_router.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/telegram", "dest": "pages/api/telegram.py" },
    { "src": "/api/signal_router", "dest": "pages/api/signal_router.py" }
  ],
  "crons": [
    {
      "path": "/api/signal_router?timeframe=5m",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/signal_router?timeframe=15m",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/signal_router?timeframe=1h",
      "schedule": "0 * * * *"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.11"
  }
}